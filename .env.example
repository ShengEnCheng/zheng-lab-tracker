# Supabase project URL, for example https://<project>.supabase.co
SUPABASE_URL=

# Public anon key used with the authenticated user's JWT.
SUPABASE_ANON_KEY=

# Local-only Supabase Personal Access Token for running migrations via Management API.
# Never expose, commit, or paste this token into frontend code or chat.
SUPABASE_ACCESS_TOKEN=

# Server-only key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Required by the scheduled backup endpoint for manual invocations.
CRON_SECRET=

# Optional comma-separated allow-list enforced by the application layer.
ZHENG_ALLOWED_EMAILS=
